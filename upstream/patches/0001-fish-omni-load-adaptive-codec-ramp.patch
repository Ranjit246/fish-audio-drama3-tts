@@ -0,0 +1,41 @@
+# Fish Audio Drama 3, low-latency profile: an overlay on fish_omni.yaml for
+# deployments that care about time-to-first-audio at <= 24 concurrent streams
+# (voice agents, telephony) more than about 128-stream throughput.
+#
+# Measured on 1x RTX PRO 6000 Blackwell 96 GB (vLLM 0.31.0, vllm-omni c470395),
+# Seed-TTS-Eval en, references pre-encoded (ref_audio_codes), streaming pcm,
+# top_k 100, a fresh server per concurrency, 300 lines per level:
+#   c=1   TTFA p50 48 ms  (stock 80 ms),  RTF 0.177, no audible (> 100 ms) stalls
+#   c=16  TTFA p50 88 ms  (stock 162 ms), RTF 0.408, no audible stalls
+#   c=24  TTFA p50 149 ms,                RTF 0.495, no audible stalls
+#   c=32  TTFA p50 222 ms,                RTF 0.558, no audible stalls
+#   c=64  TTFA p50 350 ms (stock 352 ms), RTF 0.700, 2.3% of streams stall (stock 1.3%)
+# A 4-frame first window at 32 streams stalled 1.7-4% of streams and 91% at
+# 64; above 24 streams only the stock ramp is safe.
+# Launch: vllm serve fishaudio/drama-3 --omni --deploy-config vllm_omni/deploy/fish_omni_low_latency.yaml
+base_config: fish_omni.yaml
+connectors:
+  connector_of_shared_memory:
+    extra:
+      # A stream's first windows are sized at its first decode step from the
+      # requests in that step (the smallest threshold at or above that count),
+      # so a burst of arrivals sees itself. Each window must be generated
+      # before the audio already sent runs out: frames(n+1) x step_ms <
+      # 46.4 ms x frames sent so far, and a decode step takes ~26 ms at 32
+      # streams. So a 2-frame first window (93 ms of audio, the codec starts
+      # 4 steps earlier than with 6) up to 16 streams, 4 frames up to 24, and
+      # the stock ramp above that.
+      codec_chunk_ramp_by_load: "16:2,4,8,16,32;24:4,6,12,24,32;*:6,8,12,16,24,32"
+      # The base's one-size ramp; the table above replaces it.
+      codec_chunk_ramp: null
+      # Prefill admission stays at the base's values: it protects saturation
+      # and only applies from 32 running requests.
+stages:
+  - stage_id: 0
+    max_num_seqs: 64
+    # Lets requests ask for main-token top_k up to 128 (the fused sampler caps at
+    # 64 by default); see sgl-project/sglang-omni#2823 on top_k 30 and silence.
+    hf_overrides:
+      fish_omni_max_top_k: 128
+  - stage_id: 1
+    max_num_seqs: 64
